# Template file for the sensor API container.
# Copy to local .env file with updated values

# Shared secret the ESP32 must send in the X-API-Key header.
# Generate with: openssl rand -hex 32
API_KEY=

# Some candidate production settings
APP_DATA=/cluster-data/ttp-sensor-api/data
APP_LOGS=/cluster-data/ttp-sensor-api/logs
